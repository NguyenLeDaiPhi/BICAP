<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-icon.png">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <title><%= farm && farm.farmName ? farm.farmName : 'Thông tin trang trại' %> - BICAP Farm</title>
  <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,900" />
  <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link id="pagestyle" href="/assets/css/material-dashboard.css?v=3.2.0" rel="stylesheet" />
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 50%, #00875A 100%);
      --secondary-gradient: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);
      --success-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 100%);
      --card-shadow: 0 10px 40px rgba(0,0,0,0.08);
      --hover-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    body { font-family: 'Inter', sans-serif; }

    /* Navigation Styles */
    .sidenav { min-height: 100vh; }
    .sidenav .navbar-nav { list-style: none; padding: 0; margin: 0; }
    .sidenav .nav-item { margin-bottom: 4px; }
    
    .sidenav .nav-link {
      display: flex !important;
      align-items: center;
      padding: 14px 18px;
      margin: 6px 12px;
      border-radius: 16px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2D3436 !important;
      font-weight: 500;
      position: relative;
      text-decoration: none;
      width: auto;
      min-height: 48px;
      overflow: hidden;
    }
    
    .sidenav .nav-link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: var(--success-gradient);
      border-radius: 0 8px 8px 0;
      transform: scaleY(0);
      transition: transform 0.3s ease;
    }
    
    .sidenav .nav-link:hover::before { transform: scaleY(1); }
    
    .sidenav .nav-link i {
      font-size: 22px !important;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 14px;
      opacity: 0.7;
      transition: all 0.4s ease;
      flex-shrink: 0;
    }
    
    .sidenav .nav-link .nav-link-text {
      font-size: 14px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    
    .sidenav .nav-link:not(.active):hover {
      background: rgba(0, 184, 148, 0.08) !important;
      color: #00B894 !important;
      transform: translateX(6px);
    }
    
    .sidenav .nav-link:not(.active):hover i {
      opacity: 1;
      color: #00B894;
      transform: scale(1.15);
    }
    
    .sidenav .nav-link.active {
      background: var(--success-gradient) !important;
      color: #ffffff !important;
      box-shadow: 0 8px 24px rgba(0, 184, 148, 0.4);
    }
    
    .sidenav .nav-link.active i {
      opacity: 1;
      color: #ffffff !important;
      transform: scale(1.1);
    }
    
    .sidenav .nav-link.active .nav-link-text {
      font-weight: 600;
      color: #ffffff !important;
    }
    
    .sidenav .nav-item.mt-3 h6 {
      padding: 10px 18px;
      margin: 20px 12px 10px 12px;
      font-size: 11px;
      letter-spacing: 1px;
      color: #636E72;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    #sidenav-collapse-main { display: block !important; visibility: visible !important; opacity: 1 !important; }
    #sidenav-collapse-main.show { display: block !important; }
    .sidenav .navbar-nav { display: block !important; }
    .sidenav-footer { position: absolute; bottom: 0; width: 100%; padding-bottom: 20px; }
    .sidenav .nav-item { display: block !important; visibility: visible !important; opacity: 1 !important; }
    .sidenav .nav-link.text-dark { color: #2D3436 !important; }

    /* Card Animations */
    .card {
      border: none;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .card:hover { transform: translateY(-5px); box-shadow: var(--hover-shadow); }

    /* Page Header */
    .page-header {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border-radius: 20px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    .page-header h3 { font-weight: 700; color: #2D3436; margin-bottom: 8px; }
    .page-header p { color: #636E72; margin: 0; }

    /* Info Cards */
    .info-card-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.4s ease;
    }
    .info-card:hover .info-card-icon { transform: scale(1.1) rotate(5deg); }

    /* Badge Styles */
    .badge-modern {
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 11px;
    }

    /* Button Animations */
    .btn-animated {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-animated:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }

    /* Navbar */
    .navbar-main {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 12px 20px;
      margin: 0 12px;
    }
    .breadcrumb-item a { color: #636E72; text-decoration: none; transition: color 0.3s; }
    .breadcrumb-item a:hover { color: #00B894; }
    .breadcrumb-item.active { color: #2D3436; font-weight: 600; }

    /* Form Styles */
    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #E9ECEF;
      padding: 12px 16px;
      transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
      border-color: #00B894;
      box-shadow: 0 0 0 4px rgba(0, 184, 148, 0.1);
    }
    .form-label { font-weight: 500; color: #2D3436; margin-bottom: 8px; }

    /* Modal Styling */
    .modal-content { border: none; border-radius: 20px; overflow: hidden; }
    .modal-header { background: var(--success-gradient); color: white; border: none; padding: 20px 24px; }
    .modal-header h5 { font-weight: 600; }
    .modal-body { padding: 24px; }
    .modal-footer { border: none; padding: 16px 24px 24px; }

    /* Certificate Badges */
    .cert-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 20px;
      background: linear-gradient(135deg, #00B894 0%, #00A86B 100%);
      color: white;
      font-weight: 600;
      font-size: 12px;
      transition: all 0.3s ease;
    }
    .cert-badge:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0, 184, 148, 0.3); }
  </style>
</head>

<body class="g-sidenav-show bg-gray-100">
  <!-- Sidebar -->
  <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-radius-lg fixed-start ms-2 bg-white my-2" id="sidenav-main">
    <div class="sidenav-header">
      <i class="fas fa-times p-3 cursor-pointer text-dark opacity-5 position-absolute end-0 top-0 d-none d-xl-none" aria-hidden="true" id="iconSidenav"></i>
      <a class="navbar-brand px-4 py-3 m-0" href="/dashboard">
        <div class="d-flex align-items-center">
          <div style="width:40px;height:40px;border-radius:12px;background:var(--success-gradient);display:flex;align-items:center;justify-content:center;margin-right:10px;">
            <i class="material-symbols-rounded text-white" style="font-size:22px;">agriculture</i>
          </div>
          <span class="ms-1 text-sm text-dark font-weight-bolder" style="font-size:16px !important;">BICAP Farm</span>
        </div>
      </a>
    </div>
    <hr class="horizontal dark mt-0 mb-2">
    <div class="collapse navbar-collapse w-auto show" id="sidenav-collapse-main" style="display: block !important; visibility: visible !important; opacity: 1 !important;">
      <ul class="navbar-nav" style="display: block !important; visibility: visible !important;">
        <li class="nav-item">
          <a class="nav-link" href="/dashboard">
            <i class="material-symbols-rounded">dashboard</i>
            <span class="nav-link-text">Trang chủ</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/products">
            <i class="material-symbols-rounded">storefront</i>
            <span class="nav-link-text">Quản lý sản phẩm</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/shipping">
            <i class="material-symbols-rounded">local_shipping</i>
            <span class="nav-link-text">Vận chuyển</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/season-monitor">
            <i class="material-symbols-rounded">grass</i>
            <span class="nav-link-text">Quản lý mùa vụ</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/farm-info">
            <i class="material-symbols-rounded">agriculture</i>
            <span class="nav-link-text">Thông tin trang trại</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/notifications">
            <i class="material-symbols-rounded">notifications</i>
            <span class="nav-link-text">Thông báo</span>
          </a>
        </li>
        <li class="nav-item mt-3">
          <h6>Tài khoản</h6>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/profile">
            <i class="material-symbols-rounded">person</i>
            <span class="nav-link-text">Hồ sơ cá nhân</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="javascript:void(0);" id="logout-button">
            <i class="material-symbols-rounded">logout</i>
            <span class="nav-link-text">Đăng xuất</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="sidenav-footer position-absolute w-100 bottom-0">
      <div class="mx-3 mb-3">
        <div class="card" style="border-radius:20px;background:var(--success-gradient);">
          <div class="card-body p-3 text-center text-white">
            <div style="width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
              <i class="material-symbols-rounded" style="font-size:28px;">eco</i>
            </div>
            <p class="text-sm mb-1 font-weight-bold">BICAP Farm</p>
            <p class="text-xs mb-0 opacity-80">Hệ thống quản lý</p>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <!-- Navbar -->
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-3 shadow-none" id="navbarBlur" data-scroll="true">
      <div class="container-fluid py-1 px-3">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
            <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="javascript:;">Trang</a></li>
            <li class="breadcrumb-item text-sm text-dark active font-weight-bold" aria-current="page">Thông tin trang trại</li>
          </ol>
        </nav>
        <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
          <div class="ms-md-auto pe-md-3 d-flex align-items-center">
            <div class="input-group input-group-outline">
              <label class="form-label text-muted">Tìm kiếm...</label>
              <input type="text" class="form-control">
            </div>
          </div>
          <ul class="navbar-nav d-flex align-items-center justify-content-end">
            <li class="nav-item d-xl-none ps-3 d-flex align-items-center">
              <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                <div class="sidenav-toggler-inner">
                  <i class="sidenav-toggler-line"></i>
                  <i class="sidenav-toggler-line"></i>
                  <i class="sidenav-toggler-line"></i>
                </div>
              </a>
            </li>
            <li class="nav-item d-flex align-items-center">
              <a href="/profile" class="nav-link text-body font-weight-bold px-0">
                <i class="material-symbols-rounded">account_circle</i>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container-fluid px-2 px-md-4">
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show mx-3 mx-md-4 mt-4" role="alert" style="border-radius: 16px;">
          <i class="material-symbols-rounded me-2">error</i>
          <strong>Đã xảy ra lỗi:</strong> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <% if (!farm) { %>
        <!-- No Farm Card -->
        <div class="card mx-3 mx-md-4 mt-4">
          <div class="card-body text-center py-5">
            <div style="width:100px;height:100px;border-radius:50%;background:linear-gradient(135deg, #00B894 0%, #00A86B 100%);display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
              <i class="material-symbols-rounded text-white" style="font-size:48px;">agriculture</i>
            </div>
            <h4 class="mt-3 mb-3">Chưa có thông tin trang trại</h4>
            <p class="text-muted mb-4">Bạn chưa tạo trang trại. Hãy tạo trang trại mới để bắt đầu sử dụng hệ thống.</p>
            <div class="d-flex justify-content-center gap-3">
              <button type="button" class="btn btn-success btn-animated" data-bs-toggle="modal" data-bs-target="#createFarmModal">
                <i class="material-symbols-rounded me-2">add</i> Tạo trang trại mới
              </button>
              <a href="/dashboard" class="btn btn-outline-secondary btn-animated">
                <i class="material-symbols-rounded me-2">home</i> Quay lại trang chủ
              </a>
            </div>
          </div>
        </div>

        <!-- Create Farm Modal -->
        <div class="modal fade" id="createFarmModal" tabindex="-1" aria-labelledby="createFarmModalLabel" aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5><i class="material-symbols-rounded me-2">add_business</i> Tạo trang trại mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <form id="createFarmForm" action="/farm-info/create" method="POST">
                <div class="modal-body">
                  <div class="row">
                    <div class="col-md-6 mb-4">
                      <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">business</i> Tên trang trại <span class="text-danger">*</span></label>
                      <input type="text" class="form-control" id="farmName" name="farmName" required placeholder="VD: Trang trại hữu cơ ABC">
                    </div>
                    <div class="col-md-6 mb-4">
                      <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">call</i> Số điện thoại</label>
                      <input type="tel" class="form-control" id="phone" name="phone" placeholder="VD: 0912 345 678">
                    </div>
                  </div>
                  <div class="mb-4">
                    <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">location_on</i> Địa chỉ <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="address" name="address" rows="2" required placeholder="VD: 123 Đường ABC, Quận 1, TP.HCM"></textarea>
                  </div>
                  <div class="row">
                    <div class="col-md-6 mb-4">
                      <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">email</i> Email</label>
                      <input type="email" class="form-control" id="email" name="email" value="<%= user?.email || '' %>" placeholder="VD: farm@email.com">
                    </div>
                    <div class="col-md-6 mb-4">
                      <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">square_foot</i> Diện tích (Ha)</label>
                      <input type="number" class="form-control" id="area" name="area" step="0.01" min="0" placeholder="VD: 5.5">
                    </div>
                  </div>
                  <div class="mb-4">
                    <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">description</i> Mô tả</label>
                    <textarea class="form-control" id="description" name="description" rows="3" placeholder="Mô tả về trang trại của bạn..."></textarea>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                  <button type="submit" class="btn btn-success btn-animated">
                    <i class="material-symbols-rounded me-1">save</i> Tạo trang trại
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% } else { %>
      
      <!-- Farm Profile Header -->
      <div class="page-header min-height-300 border-radius-xl mt-4" style="background-image: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?ixlib=rb-1.2.1&auto=format&fit=crop&w=1932&q=80');">
        <span class="mask bg-gradient-dark opacity-6"></span>
      </div>

      <!-- Farm Info Card -->
      <div class="card card-body mx-3 mx-md-4 mt-n6">
        <div class="row g-4 mb-4">
          <div class="col-auto">
            <div class="avatar avatar-xl position-relative">
              <img src="<%= (farm && farm.image) ? farm.image : '/assets/img/farm-organic-1.png' %>" alt="profile_image" class="w-100 border-radius-lg shadow-sm" style="border: 4px solid white;">
            </div>
          </div>
          <div class="col-auto my-auto">
            <div class="h-100">
              <h3 class="mb-1"><%= farm ? farm.farmName : 'Đang tải tên trang trại...' %></h3>
              <p class="mb-0 text-muted">
                <i class="material-symbols-rounded text-sm me-1">eco</i> Nông sản sạch - Cuộc sống xanh
              </p>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 my-sm-auto ms-sm-auto me-sm-0 mx-auto mt-3">
            <div class="nav-wrapper position-relative end-0">
              <a href="/farm-info/edit" class="btn btn-success btn-animated w-100">
                <i class="material-symbols-rounded text-sm me-2">edit</i> Chỉnh sửa thông tin
              </a>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <!-- Basic Info Card -->
          <div class="col-12 col-xl-4">
            <div class="card info-card h-100">
              <div class="card-header p-4" style="background: var(--primary-gradient);">
                <div class="d-flex align-items-center gap-3">
                  <div class="info-card-icon bg-white bg-opacity-25">
                    <i class="material-symbols-rounded text-white">info</i>
                  </div>
                  <div>
                    <h5 class="text-white mb-0">Thông tin cơ bản</h5>
                  </div>
                </div>
              </div>
              <div class="card-body p-4">
                <ul class="list-unstyled">
                  <li class="d-flex align-items-start mb-3">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">business</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Tên trang trại</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm ? farm.farmName : 'Chưa cập nhật' %></p>
                    </div>
                  </li>
                  <li class="d-flex align-items-start mb-3">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">calendar_today</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Ngày thành lập</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm && farm.createdAt ? new Date(farm.createdAt).toLocaleDateString('vi-VN') : 'Chưa cập nhật' %></p>
                    </div>
                  </li>
                  <li class="d-flex align-items-start mb-3">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">square_foot</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Diện tích</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm ? farm.areaSize : 0 %> Ha</p>
                    </div>
                  </li>
                  <li class="d-flex align-items-start mb-3">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">call</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Hotline</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm && farm.hotline ? farm.hotline : 'Chưa cập nhật' %></p>
                    </div>
                  </li>
                  <li class="d-flex align-items-start mb-3">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">email</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Email</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm && farm.email ? farm.email : 'Chưa cập nhật' %></p>
                    </div>
                  </li>
                  <li class="d-flex align-items-start">
                    <div style="width:40px;height:40px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;">
                      <i class="material-symbols-rounded text-success" style="font-size:20px;">location_on</i>
                    </div>
                    <div>
                      <p class="text-xs text-muted mb-0">Địa chỉ</p>
                      <p class="text-sm font-weight-semibold mb-0"><%= farm && farm.address ? farm.address : 'Chưa cập nhật' %></p>
                    </div>
                  </li>
                </ul>

                <div class="mt-4">
                  <p class="text-xs text-muted mb-2">Chứng nhận</p>
                  <div class="d-flex flex-wrap gap-2">
                    <span class="cert-badge"><i class="material-symbols-rounded" style="font-size:14px;">verified</i> VietGAP</span>
                    <span class="cert-badge" style="background: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);"><i class="material-symbols-rounded" style="font-size:14px;">public</i> GlobalGAP</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Owner & Description Card -->
          <div class="col-12 col-xl-8">
            <div class="card info-card h-100">
              <div class="card-header p-4" style="background: var(--secondary-gradient);">
                <div class="d-flex align-items-center gap-3">
                  <div class="info-card-icon bg-white bg-opacity-25">
                    <i class="material-symbols-rounded text-white">person</i>
                  </div>
                  <div>
                    <h5 class="text-white mb-0">Chủ sở hữu & Giới thiệu</h5>
                  </div>
                </div>
              </div>
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4 p-3" style="background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%); border-radius: 16px;">
                  <div style="width:60px;height:60px;border-radius:16px;background:var(--primary-gradient);display:flex;align-items:center;justify-content:center;margin-right:16px;">
                    <i class="material-symbols-rounded text-white" style="font-size:28px;">person_pin</i>
                  </div>
                  <div>
                    <h5 class="mb-1"><%= user.username || 'Người dùng' %></h5>
                    <p class="text-sm text-muted mb-0"><i class="material-symbols-rounded text-sm me-1">badge</i> Chủ nhiệm HTX</p>
                  </div>
                </div>
                
                <h6 class="text-uppercase text-muted text-xs font-weight-bold mb-3">Giới thiệu chung</h6>
                <p class="text-sm" style="line-height: 1.8;">
                  <%= farm && farm.description ? farm.description : 'Chưa có mô tả giới thiệu về trang trại. Hãy cập nhật thông tin để giới thiệu về trang trại của bạn.' %>
                </p>

                <div class="row mt-4">
                  <div class="col-md-4">
                    <div class="text-center p-3" style="background: linear-gradient(135deg, rgba(0,184,148,0.1) 0%, rgba(0,184,148,0.05) 100%); border-radius: 16px;">
                      <h3 class="text-success mb-0"><%= farm ? farm.areaSize : 0 %></h3>
                      <p class="text-xs text-muted mb-0">Diện tích (Ha)</p>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="text-center p-3" style="background: linear-gradient(135deg, rgba(108,92,231,0.1) 0%, rgba(108,92,231,0.05) 100%); border-radius: 16px;">
                      <h3 class="text-primary mb-0">5</h3>
                      <p class="text-xs text-muted mb-0">Mùa vụ đang hoạt động</p>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="text-center p-3" style="background: linear-gradient(135deg, rgba(253,203,110,0.2) 0%, rgba(253,203,110,0.05) 100%); border-radius: 16px;">
                      <h3 class="text-warning mb-0">12</h3>
                      <p class="text-xs text-muted mb-0">Sản phẩm đã niêm yết</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Footer -->
      <footer class="footer py-4">
        <div class="container-fluid">
          <div class="row align-items-center justify-content-lg-between">
            <div class="col-lg-6 mb-lg-0 mb-4">
              <div class="copyright text-center text-sm text-muted text-lg-start">
                © <script>document.write(new Date().getFullYear())</script>,
                được phát triển với <i class="fa fa-heart text-danger"></i> bởi
                <a href="https://www.bicap.vn" class="font-weight-bold text-success" target="_blank">BiCap Team</a>
              </div>
            </div>
          </div>
        </div>
      </footer>
      <% } %>
    </div>
  </main>
  
  <script src="/assets/js/core/popper.min.js"></script>
  <script src="/assets/js/core/bootstrap.min.js"></script>
  <script src="/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = { damping: '0.5' }
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
  </script>
  <script src="/assets/js/material-dashboard.min.js?v=3.2.0"></script>
  <script>
    (function() {
      function showNavigation() {
        const sidenavCollapse = document.getElementById('sidenav-collapse-main');
        if (sidenavCollapse) {
          sidenavCollapse.classList.add('show');
          sidenavCollapse.style.display = 'block';
          sidenavCollapse.style.visibility = 'visible';
          sidenavCollapse.style.opacity = '1';
        }
        const navItems = document.querySelectorAll('.sidenav .nav-item');
        navItems.forEach(item => { item.style.display = 'block'; item.style.visibility = 'visible'; item.style.opacity = '1'; });
        const navLinks = document.querySelectorAll('.sidenav .nav-link');
        navLinks.forEach(link => { link.style.display = 'flex'; link.style.visibility = 'visible'; link.style.opacity = '1'; });
      }
      
      showNavigation();
      
      document.addEventListener('DOMContentLoaded', function() {
        showNavigation();
        
        const logoutButton = document.getElementById('logout-button');
        if (logoutButton) {
          logoutButton.addEventListener('click', async function(event) {
            event.preventDefault();
            try {
              await fetch('/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }});
              window.location.href = '/login'; 
            } catch (error) { window.location.href = '/login'; }
          });
        }
      });
      
      setTimeout(showNavigation, 100);
      setTimeout(showNavigation, 500);
    })();
  </script>
</body>
</html>
