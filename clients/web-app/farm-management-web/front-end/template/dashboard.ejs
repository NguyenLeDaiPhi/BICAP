  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 50%, #00875A 100%);
      --secondary-gradient: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);
      --success-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 100%);
      --warning-gradient: linear-gradient(135deg, #FDCB6E 0%, #F39C12 100%);
      --danger-gradient: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
      --info-gradient: linear-gradient(135deg, #74B9FF 0%, #0984E3 100%);
      --dark-gradient: linear-gradient(135deg, #2D3436 0%, #1E272E 100%);
      --card-shadow: 0 10px 40px rgba(0,0,0,0.08);
      --hover-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    * { box-sizing: border-box; }
    
    body { font-family: 'Inter', sans-serif; }

    /* Navigation Styles */
    .sidenav { min-height: 100vh; }
    .sidenav .navbar-nav { list-style: none; padding: 0; margin: 0; }
    .sidenav .nav-item { margin-bottom: 4px; }
    
    .sidenav .nav-link {
      display: flex !important;
      align-items: center;
      padding: 14px 18px;
      margin: 6px 12px;
      border-radius: 16px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2D3436 !important;
      font-weight: 500;
      position: relative;
      text-decoration: none;
      width: auto;
      min-height: 48px;
      overflow: hidden;
    }
    
    .sidenav .nav-link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: var(--success-gradient);
      border-radius: 0 8px 8px 0;
      transform: scaleY(0);
      transition: transform 0.3s ease;
    }
    
    .sidenav .nav-link:hover::before { transform: scaleY(1); }
    
    .sidenav .nav-link i {
      font-size: 22px !important;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 14px;
      opacity: 0.7;
      transition: all 0.4s ease;
      flex-shrink: 0;
    }
    
    .sidenav .nav-link .nav-link-text {
      font-size: 14px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    
    .sidenav .nav-link:not(.active):hover {
      background: rgba(0, 184, 148, 0.08) !important;
      color: #00B894 !important;
      transform: translateX(6px);
    }
    
    .sidenav .nav-link:not(.active):hover i {
      opacity: 1;
      color: #00B894;
      transform: scale(1.15);
    }
    
    .sidenav .nav-link.active {
      background: var(--success-gradient) !important;
      color: #ffffff !important;
      box-shadow: 0 8px 24px rgba(0, 184, 148, 0.4);
    }
    
    .sidenav .nav-link.active::before { transform: scaleY(1); }
    
    .sidenav .nav-link.active i {
      opacity: 1;
      color: #ffffff !important;
      transform: scale(1.1);
    }
    
    .sidenav .nav-link.active .nav-link-text {
      font-weight: 600;
      color: #ffffff !important;
    }
    
    .sidenav .nav-item.mt-3 h6 {
      padding: 10px 18px;
      margin: 20px 12px 10px 12px;
      font-size: 11px;
      letter-spacing: 1px;
      color: #636E72;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    #sidenav-collapse-main {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
    }
    #sidenav-collapse-main.show { display: block !important; }
    .sidenav .navbar-nav { display: block !important; }
    .sidenav-footer { position: absolute; bottom: 0; width: 100%; padding-bottom: 20px; }
    .sidenav .nav-item { display: block !important; visibility: visible !important; opacity: 1 !important; }
    .sidenav .nav-link.text-dark { color: #2D3436 !important; }

    /* Card Animations */
    .card {
      border: none;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .card:hover {
      transform: translateY(-8px);
      box-shadow: var(--hover-shadow);
    }
    
    /* Stat Cards */
    .stat-card {
      border-radius: 24px;
      overflow: hidden;
      position: relative;
      animation: fadeInUp 0.6s ease-out;
    }
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 150px;
      height: 150px;
      background: rgba(255,255,255,0.1);
      border-radius: 50%;
      transform: translate(50%, -50%);
      animation: pulse 3s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { transform: translate(50%, -50%) scale(1); opacity: 0.1; }
      50% { transform: translate(50%, -50%) scale(1.2); opacity: 0.2; }
    }
    
    .stat-card .card-header {
      padding: 24px 28px;
      position: relative;
      z-index: 1;
    }
    .stat-card .card-body { padding: 20px 28px 28px; }
    
    .stat-icon {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      transition: all 0.4s ease;
      box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
    .stat-card:hover .stat-icon {
      transform: scale(1.1) rotate(5deg);
    }
    
    .stat-value {
      font-size: 32px;
      font-weight: 700;
      line-height: 1.2;
      background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.8) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    
    .stat-label {
      font-size: 14px;
      opacity: 0.9;
      font-weight: 500;
    }
    
    .stat-footer {
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      padding: 14px 28px;
      border-top: 1px solid rgba(255,255,255,0.1);
    }
    
    /* Colorful Gradients */
    .gradient-revenue { background: var(--primary-gradient); }
    .gradient-season { background: var(--secondary-gradient); }
    .gradient-orders { background: linear-gradient(135deg, #E84393 0%, #E84393 50%, #D63031 100%); }
    .gradient-stock { background: var(--info-gradient); }
    .gradient-harvest { background: var(--warning-gradient); }
    
    /* Animations */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fadeInUp { animation: fadeInUp 0.6s ease-out; }
    
    @keyframes slideIn {
      from { opacity: 0; transform: translateX(-20px); }
      to { opacity: 1; transform: translateX(0); }
    }
    
    /* Chart Cards */
    .chart-card {
      border-radius: 20px;
      overflow: hidden;
    }
    .chart-card .card-header {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border-bottom: 1px solid #E9ECEF;
      padding: 20px 24px;
    }
    .chart-card .card-body { padding: 24px; }
    
    /* Table Styles */
    .table-modern {
      border-collapse: separate;
      border-spacing: 0;
    }
    .table-modern thead th {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border: none !important;
      font-weight: 600;
      color: #2D3436;
      padding: 16px 20px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .table-modern tbody td {
      border: none;
      border-bottom: 1px solid #F1F3F4;
      padding: 18px 20px;
      vertical-align: middle;
      transition: background 0.3s ease;
    }
    .table-modern tbody tr:hover td {
      background: rgba(0, 184, 148, 0.04);
    }
    
    /* Timeline */
    .timeline-item {
      position: relative;
      padding-left: 40px;
      padding-bottom: 24px;
      animation: slideIn 0.5s ease-out;
    }
    .timeline-item::before {
      content: '';
      position: absolute;
      left: 11px;
      top: 32px;
      bottom: 0;
      width: 2px;
      background: linear-gradient(180deg, #00B894 0%, #E9ECEF 100%);
    }
    .timeline-item:last-child::before { display: none; }
    
    .timeline-dot {
      position: absolute;
      left: 0;
      top: 4px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      transition: all 0.3s ease;
    }
    .timeline-item:hover .timeline-dot {
      transform: scale(1.2);
    }
    
    /* Progress Bars */
    .progress-modern {
      height: 8px;
      border-radius: 4px;
      overflow: hidden;
      background: #E9ECEF;
    }
    .progress-modern .progress-bar {
      border-radius: 4px;
      transition: width 1s ease-out;
    }
    
    /* Badge Styles */
    .badge-modern {
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 11px;
    }
    
    /* Button Animations */
    .btn-animated {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .btn-animated::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: rgba(255,255,255,0.2);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      transition: width 0.6s ease, height 0.6s ease;
    }
    .btn-animated:hover::before { width: 300px; height: 300px; }
    .btn-animated:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
    
    /* Page Header */
    .page-header {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border-radius: 20px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    .page-header h3 {
      font-weight: 700;
      color: #2D3436;
      margin-bottom: 8px;
    }
    .page-header p { color: #636E72; margin: 0; }
    
    /* Loading Animation */
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: skeleton-loading 1.5s infinite;
    }
    @keyframes skeleton-loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Navbar */
    .navbar-main {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 12px 20px;
      margin: 0 12px;
    }
    .breadcrumb-item a { color: #636E72; text-decoration: none; transition: color 0.3s; }
    .breadcrumb-item a:hover { color: #00B894; }
    .breadcrumb-item.active { color: #2D3436; font-weight: 600; }
  </style>
  <script>
    window.CONFIG = {
      API_GATEWAY_BASE_URL: "<%= API_GATEWAY_BASE_URL %>",
      MARKETPLACE_API_PATH: "<%= MARKETPLACE_API_PATH %>",
      FARMING_SEASONS_API_PATH: "<%= FARMING_SEASONS_API_PATH %>"
    };
  </script>
</head>

