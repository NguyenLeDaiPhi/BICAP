  <script>
    let eventSource = null;
    const notificationsContainer = document.getElementById('notifications-container');
    const emptyState = document.getElementById('empty-state');
    const connectionStatus = document.getElementById('connection-status');
    const statusText = document.getElementById('status-text');

    function connectSSE() {
      eventSource = new EventSource('/api/notifications/stream');
      
      eventSource.onopen = () => {
        console.log('✓ Đã kết nối SSE');
        connectionStatus.className = 'status-badge status-connected';
        statusText.textContent = 'Đã kết nối';
      };
      
      eventSource.onmessage = (event) => {
        try {
          const notification = JSON.parse(event.data);
          if (notification.type !== 'connected') {
            addNotification(notification);
          }
        } catch (error) {
          console.error('Lỗi xử lý thông báo:', error);
        }
      };
      
      eventSource.onerror = (error) => {
        console.error('Lỗi SSE:', error);
        connectionStatus.className = 'status-badge status-disconnected';
        statusText.textContent = 'Mất kết nối';
        
        setTimeout(() => {
          eventSource.close();
          connectSSE();
        }, 5000);
      };
    }

    function addNotification(notification) {
      emptyState.style.display = 'none';
      
      const notifElement = createNotificationElement(notification);
      notificationsContainer.insertBefore(notifElement, notificationsContainer.firstChild);
      
      setTimeout(() => notifElement.classList.add('show'), 10);
      playNotificationSound();
    }

    function createNotificationElement(notification) {
      const div = document.createElement('div');
      div.className = 'notification-item';
      div.id = 'notif-' + notification.id;
      
      const typeConfig = getNotificationTypeConfig(notification.type);
      const timeAgo = formatTimeAgo(notification.timestamp);
      
      div.innerHTML = `
        <div class="d-flex align-items-start gap-3">
          <div class="notification-icon ${typeConfig.iconBg}" style="${typeConfig.iconStyle}">
            <i class="material-symbols-rounded ${typeConfig.iconColor}">${typeConfig.icon}</i>
          </div>
          <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h6 class="mb-0 font-weight-bold" style="color: ${typeConfig.titleColor};">${notification.title || 'Thông báo'}</h6>
              <small class="text-muted">${timeAgo}</small>
            </div>
            <p class="mb-2" style="color: #636E72;">${notification.message}</p>
            ${notification.from ? `<small class="text-muted"><i class="material-symbols-rounded me-1" style="font-size:14px;">person</i>${notification.from}</small>` : ''}
          </div>
          <button class="btn btn-link text-danger p-1" onclick="deleteNotification('${notification.id}')" title="Xóa thông báo">
            <i class="material-symbols-rounded">close</i>
          </button>
        </div>
      `;
      
      return div;
    }

    function getNotificationTypeConfig(type) {
      const configs = {
        success: { 
          class: 'alert-success', 
          icon: 'check_circle', 
          iconBg: 'bg-gradient-success text-white',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #00B894 0%, #00A86B 100%);',
          titleColor: '#00B894'
        },
        info: { 
          class: 'alert-info', 
          icon: 'info', 
          iconBg: 'bg-gradient-info text-white',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #74B9FF 0%, #0984E3 100%);',
          titleColor: '#0984E3'
        },
        warning: { 
          class: 'alert-warning', 
          icon: 'warning', 
          iconBg: 'bg-gradient-warning text-dark',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #FDCB6E 0%, #F39C12 100%);',
          titleColor: '#F39C12'
        },
        error: { 
          class: 'alert-danger', 
          icon: 'error', 
          iconBg: 'bg-gradient-danger text-white',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);',
          titleColor: '#E74C3C'
        },
        order: { 
          class: 'alert-primary', 
          icon: 'shopping_cart', 
          iconBg: 'bg-gradient-primary text-white',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);',
          titleColor: '#6C5CE7'
        },
        shipping: { 
          class: 'alert-secondary', 
          icon: 'local_shipping', 
          iconBg: 'bg-gradient-secondary text-white',
          iconColor: '',
          iconStyle: 'background: linear-gradient(135deg, #636E72 0%, #2D3436 100%);',
          titleColor: '#636E72'
        }
      };
      return configs[type] || configs.info;
    }

    function formatTimeAgo(timestamp) {
      const now = new Date();
      const time = new Date(timestamp);
      const diffMs = now - time;
      const diffMins = Math.floor(diffMs / 60000);
      
      if (diffMins < 1) return 'Vừa xong';
      if (diffMins < 60) return diffMins + ' phút trước';
      
      const diffHours = Math.floor(diffMins / 60);
      if (diffHours < 24) return diffHours + ' giờ trước';
      
      const diffDays = Math.floor(diffHours / 24);
      return diffDays + ' ngày trước';
    }

    async function deleteNotification(id) {
      try {
        const response = await fetch(`/api/notifications/${id}`, { method: 'DELETE' });
        if (response.ok) {
          const element = document.getElementById('notif-' + id);
          if (element) {
            element.style.opacity = '0';
            element.style.transform = 'translateX(100px)';
            setTimeout(() => element.remove(), 300);
            
            if (notificationsContainer.children.length <= 1) {
              emptyState.style.display = 'block';
            }
          }
        }
      } catch (error) {
        console.error('Lỗi xóa thông báo:', error);
      }
    }

    async function clearAllNotifications() {
      if (!confirm('Bạn có chắc muốn xóa tất cả thông báo?')) return;
      
      try {
        const response = await fetch('/api/notifications', { method: 'DELETE' });
        if (response.ok) {
          const items = notificationsContainer.querySelectorAll('.notification-item');
          items.forEach((item, index) => {
            setTimeout(() => {
              item.style.opacity = '0';
              item.style.transform = 'translateX(100px)';
              setTimeout(() => item.remove(), 300);
            }, index * 50);
          });
          setTimeout(() => {
            emptyState.style.display = 'block';
          }, items.length * 50 + 300);
        }
      } catch (error) {
        console.error('Lỗi xóa thông báo:', error);
      }
    }

    async function sendTestNotification() {
      try {
        const types = ['success', 'info', 'warning', 'error', 'order', 'shipping'];
        const titles = ['Thành công!', 'Thông tin', 'Cảnh báo', 'Lỗi xảy ra', 'Đơn hàng mới', 'Vận chuyển'];
        const messages = ['Hành động đã được thực hiện thành công.', 'Đây là thông tin từ hệ thống.', 'Cần chú ý: có vấn đề cần xử lý.', 'Đã xảy ra lỗi trong quá trình xử lý.', 'Bạn có đơn hàng mới cần xử lý.', 'Đơn hàng đang được vận chuyển.'];
        const randomIndex = Math.floor(Math.random() * types.length);
        
        await fetch('/api/notifications/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: types[randomIndex],
            title: titles[randomIndex],
            message: messages[randomIndex] + ' - ' + new Date().toLocaleTimeString('vi-VN'),
            from: 'Farm Management System'
          })
        });
        
        console.log('Đã gửi thông báo test');
      } catch (error) {
        console.error('Lỗi gửi thông báo test:', error);
      }
    }

    function playNotificationSound() {
      try {
        const audio = new Audio('data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1fdJivrJBhNjVgodDbq2EcBj+a2/LDciUFLIHO8tiJNwgZaLvt559NEAxQp+PwtmMcBjiR1/LMeSwFJHfH8N2QQAoUXrTp66hVFApGn+DyvmwhBTGH0fPTgjMGHm7A7+OZVRQMUJ3h8bhiFgk+jtj02YY9CRxi');
        audio.volume = 0.3;
        audio.play().catch(e => console.log('Không thể phát âm thanh:', e));
      } catch (e) {}
    }

    document.getElementById('logout-button')?.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await fetch('/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' }});
        window.location.href = '/login';
      } catch (error) {
        window.location.href = '/login';
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      connectSSE();
      
      fetch('/api/notifications?limit=20')
        .then(res => res.json())
        .then(data => {
          if (data.notifications && data.notifications.length > 0) {
            emptyState.style.display = 'none';
            data.notifications.forEach((notification, index) => {
              setTimeout(() => {
                const notifElement = createNotificationElement(notification);
                notificationsContainer.appendChild(notifElement);
                setTimeout(() => notifElement.classList.add('show'), 10);
              }, index * 100);
            });
          }
        })
        .catch(error => console.error('Lỗi tải thông báo:', error));
    });
    
    (function() {
      function showNavigation() {
        const sidenavCollapse = document.getElementById('sidenav-collapse-main');
        if (sidenavCollapse) {
          sidenavCollapse.classList.add('show');
          sidenavCollapse.style.display = 'block';
          sidenavCollapse.style.visibility = 'visible';
          sidenavCollapse.style.opacity = '1';
        }
        const navItems = document.querySelectorAll('.sidenav .nav-item');
        navItems.forEach(item => { item.style.display = 'block'; item.style.visibility = 'visible'; item.style.opacity = '1'; });
        const navLinks = document.querySelectorAll('.sidenav .nav-link');
        navLinks.forEach(link => { link.style.display = 'flex'; link.style.visibility = 'visible'; link.style.opacity = '1'; });
      }
      
      showNavigation();
      setTimeout(showNavigation, 100);
      setTimeout(showNavigation, 500);
    })();

    window.addEventListener('beforeunload', () => {
      if (eventSource) {
        eventSource.close();
      }
    });
  </script>
</body>
</html>
