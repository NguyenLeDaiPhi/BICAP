    <div class="sidenav-footer position-absolute w-100 bottom-0">
      <div class="mx-3 mb-3">
        <div class="card" style="border-radius:20px;background:var(--success-gradient);">
          <div class="card-body p-3 text-center text-white">
            <div style="width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
              <i class="material-symbols-rounded" style="font-size:28px;">eco</i>
