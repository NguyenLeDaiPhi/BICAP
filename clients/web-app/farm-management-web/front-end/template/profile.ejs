  </aside>

  <!-- Main Content -->
  <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <!-- Navbar -->
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-3 shadow-none" id="navbarBlur" data-scroll="true">
      <div class="container-fluid py-1 px-3">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
            <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="javascript:;">Trang</a></li>
            <li class="breadcrumb-item text-sm text-dark active font-weight-bold" aria-current="page">Hồ sơ cá nhân</li>
          </ol>
        </nav>
      </div>
    </nav>

    <div class="container-fluid px-2 px-md-4 py-4">
      <!-- Page Header -->
      <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h3 class="mb-1">Hồ sơ cá nhân</h3>
            <p>Quản lý thông tin và cài đặt tài khoản của bạn.</p>
          </div>
        </div>
      </div>

      <!-- Profile Header Card -->
      <div class="card mb-4">
        <div class="page-header min-height-200 border-radius-xl" 
             style="background-image: url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?ixlib=rb-1.2.1&auto=format&fit=crop&w=1932&q=80'); margin: 0;">
          <span class="mask bg-gradient-dark opacity-6"></span>
        </div>
        <div class="card-body pb-0">
          <div class="row align-items-end">
            <div class="col-auto">
              <div class="position-relative" style="margin-top: -80px;">
                <img src="<%= user.avatar || '/assets/img/bruce-mars.jpg' %>" 
                     alt="profile_image" 
                     class="avatar-xl-custom"
                     id="avatar-preview">
              </div>
            </div>
            <div class="col-auto my-auto">
              <div class="h-100">
                <h4 class="mb-1"><%= user.username || 'Người dùng' %></h4>
                <p class="mb-0 text-muted"><i class="material-symbols-rounded text-sm me-1">email</i> <%= user.email || 'Không có email' %></p>
              </div>
            </div>
            <div class="col-lg-4 col-md-6 my-sm-auto ms-sm-auto me-sm-0 mx-auto mt-3">
              <div class="nav-wrapper position-relative end-0">
                <a href="/farm-info/edit" class="btn btn-outline-success btn-sm w-100">
                  <i class="material-symbols-rounded text-sm me-2">edit</i> Chỉnh sửa hồ sơ
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Row -->
      <div class="row">
        <!-- Profile Update Form -->
        <div class="col-12 col-xl-8">
          <div class="card">
            <div class="card-header p-4" style="background: var(--primary-gradient);">
              <div class="d-flex align-items-center gap-3">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;">
                  <i class="material-symbols-rounded text-white">manage_accounts</i>
                </div>
                <div>
                  <h5 class="text-white mb-0">Cập nhật thông tin</h5>
                  <p class="text-white text-sm mb-0 opacity-80">Cập nhật thông tin cá nhân của bạn</p>
                </div>
              </div>
            </div>
            <div class="card-body">
              <!-- Messages -->
              <div id="profile-success" class="alert alert-success" role="alert" style="display: none; border-radius: 12px;">
                <i class="material-symbols-rounded me-2">check_circle</i>
                <span></span>
              </div>
              <div id="profile-error" class="alert alert-danger" role="alert" style="display: none; border-radius: 12px;">
                <i class="material-symbols-rounded me-2">error</i>
                <span></span>
              </div>

              <form id="update-profile-form" enctype="multipart/form-data">
                <div class="row">
                  <div class="col-md-6 mb-4">
                    <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">person</i> Tên người dùng</label>
                    <input type="text" class="form-control" value="<%= user.username || '' %>" readonly>
                  </div>
                  <div class="col-md-6 mb-4">
                    <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">email</i> Email</label>
                    <input type="email" class="form-control" value="<%= user.email || '' %>" readonly>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">business</i> Giấy phép kinh doanh</label>
                  <input class="form-control" type="file" id="businessLicenseUpload" name="businessLicense" multiple accept="image/*">
                  <small class="text-muted mt-2 d-block"><i class="material-symbols-rounded" style="font-size:14px;">info</i> Tải lên hình ảnh giấy phép kinh doanh (JPEG, PNG) - tối đa 10MB mỗi ảnh</small>
                </div>
                
                <div id="licenseImagesPreview" class="row mt-3">
                </div>

                <div class="mb-4">
                  <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">home</i> Địa chỉ</label>
                  <input type="text" class="form-control" name="address" id="address" 
                         value="<%= user.address || '' %>" placeholder="Nhập địa chỉ của bạn">
                </div>

                <div class="mb-4">
                  <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">photo_camera</i> Ảnh đại diện</label>
                  <input type="file" class="form-control" name="avatar" id="avatar" accept="image/*">
                </div>

                <div class="text-center">
                  <button type="submit" class="btn btn-success btn-animated px-5" id="submit-btn">
                    <i class="material-symbols-rounded me-2">save</i> Lưu thay đổi
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-12 col-xl-4">
          <!-- Account Info -->
          <div class="card mb-4">
            <div class="card-header p-4" style="background: var(--secondary-gradient);">
              <div class="d-flex align-items-center gap-3">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;">
                  <i class="material-symbols-rounded text-white">info</i>
                </div>
                <div>
                  <h5 class="text-white mb-0">Thông tin tài khoản</h5>
                </div>
              </div>
            </div>
            <div class="card-body p-0">
              <ul class="info-list px-4">
                <li>
                  <div class="info-icon bg-gradient-success text-white">
                    <i class="material-symbols-rounded">badge</i>
                  </div>
                  <div>
                    <p class="text-xs text-muted mb-0">Vai trò</p>
                    <p class="text-sm font-weight-bold mb-0"><%= user.role || 'Quản lý trang trại' %></p>
                  </div>
                </li>
                <li>
                  <div class="info-icon bg-gradient-info text-white">
                    <i class="material-symbols-rounded">calendar_today</i>
                  </div>
                  <div>
                    <p class="text-xs text-muted mb-0">Ngày tham gia</p>
                    <p class="text-sm font-weight-bold mb-0"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('vi-VN') : 'Chưa xác định' %></p>
                  </div>
                </li>
                <li>
                  <div class="info-icon bg-gradient-warning text-dark">
                    <i class="material-symbols-rounded">verified</i>
                  </div>
                  <div>
                    <p class="text-xs text-muted mb-0">Trạng thái</p>
                    <p class="text-sm font-weight-bold mb-0"><span class="badge badge-modern bg-gradient-success"><i class="material-symbols-rounded me-1" style="font-size:12px;">check_circle</i> Đã xác minh</span></p>
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <!-- Security -->
          <div class="card">
            <div class="card-header p-4" style="background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);">
              <div class="d-flex align-items-center gap-3">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;">
                  <i class="material-symbols-rounded text-white">security</i>
                </div>
                <div>
                  <h5 class="text-white mb-0">Bảo mật</h5>
                </div>
              </div>
            </div>
            <div class="card-body">
              <a href="/change-password" class="btn btn-outline-danger btn-animated w-100 mb-3">
                <i class="material-symbols-rounded me-2">lock</i> Đổi mật khẩu
              </a>
              <button class="btn btn-outline-secondary btn-animated w-100" onclick="window.location.href='/notifications'">
                <i class="material-symbols-rounded me-2">notifications</i> Cài đặt thông báo
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Scripts -->
  <script src="/assets/js/core/popper.min.js"></script>
  <script src="/assets/js/core/bootstrap.min.js"></script>
  <script src="/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script src="/assets/js/material-dashboard.min.js?v=3.2.0"></script>
  <script src="/src/UpdateProfile.js"></script>
  <script id="existingBusinessLicensesData" type="application/json"><%- JSON.stringify(user.businessLicenses || []) %></script>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const licenseImagesPreview = document.getElementById('licenseImagesPreview');

      const existingBusinessLicenses = JSON.parse(document.getElementById('existingBusinessLicensesData')?.textContent || '[]');
      
      if (existingBusinessLicenses.length > 0 && licenseImagesPreview) {
        existingBusinessLicenses.forEach(license => {
          let imgSrc = license.licensePath;
          if (license.licenseBase64 && !imgSrc.startsWith('data:')) {
             imgSrc = `data:image/png;base64,${license.licenseBase64}`;
          }

          if (imgSrc) {
            const imgCol = document.createElement('div');
            imgCol.classList.add('col-md-3', 'col-sm-6', 'mb-3');
            imgCol.innerHTML = `
              <div class="image-preview-item">
                <img src="${imgSrc}" alt="Business License" class="img-fluid rounded" style="max-height: 150px; object-fit: cover; width: 100%;">
              </div>
            `;
            imgCol.querySelector('img').onerror = function() { 
                this.src = '/assets/img/image_placeholder.jpg';
            };
            licenseImagesPreview.appendChild(imgCol);
          }
        });
      }
    });
  </script>

  <script>
    (function() {
      function showNavigation() {
        const sidenavCollapse = document.getElementById('sidenav-collapse-main');
        if (sidenavCollapse) {
          sidenavCollapse.classList.add('show');
          sidenavCollapse.style.display = 'block';
          sidenavCollapse.style.visibility = 'visible';
          sidenavCollapse.style.opacity = '1';
        }
        const navItems = document.querySelectorAll('.sidenav .nav-item');
        navItems.forEach(item => { item.style.display = 'block'; item.style.visibility = 'visible'; item.style.opacity = '1'; });
        const navLinks = document.querySelectorAll('.sidenav .nav-link');
        navLinks.forEach(link => { link.style.display = 'flex'; link.style.visibility = 'visible'; link.style.opacity = '1'; });
      }
      
      showNavigation();
      
      document.addEventListener('DOMContentLoaded', function() {
        showNavigation();
        
        document.getElementById('logout-button')?.addEventListener('click', async (e) => {
          e.preventDefault();
          try {
            await fetch('/logout', { method: 'POST' });
          } finally {
            window.location.href = '/login';
          }
        });
      });
      
      setTimeout(showNavigation, 100);
      setTimeout(showNavigation, 500);
    })();
  </script>
</body>
</html>
