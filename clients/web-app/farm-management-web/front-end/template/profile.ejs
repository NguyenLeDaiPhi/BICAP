<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-icon.png">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <title>Hồ sơ cá nhân - BICAP Farm</title>

  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,900" />
  <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link id="pagestyle" href="/assets/css/material-dashboard.css?v=3.2.0" rel="stylesheet" />
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 50%, #00875A 100%);
      --secondary-gradient: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);
      --success-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 100%);
      --card-shadow: 0 10px 40px rgba(0,0,0,0.08);
      --hover-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    body { font-family: 'Inter', sans-serif; }

    /* Navigation Styles */
    .sidenav { min-height: 100vh; }
    .sidenav .navbar-nav { list-style: none; padding: 0; margin: 0; }
    .sidenav .nav-item { margin-bottom: 4px; }
    
    .sidenav .nav-link {
      display: flex !important;
      align-items: center;
      padding: 14px 18px;
      margin: 6px 12px;
      border-radius: 16px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2D3436 !important;
      font-weight: 500;
      position: relative;
      text-decoration: none;
      width: auto;
      min-height: 48px;
      overflow: hidden;
    }
    
    .sidenav .nav-link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: var(--success-gradient);
      border-radius: 0 8px 8px 0;
      transform: scaleY(0);
      transition: transform 0.3s ease;
    }
    
    .sidenav .nav-link:hover::before { transform: scaleY(1); }
    
    .sidenav .nav-link i {
      font-size: 22px !important;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 14px;
      opacity: 0.7;
      transition: all 0.4s ease;
      flex-shrink: 0;
    }
    
    .sidenav .nav-link .nav-link-text {
      font-size: 14px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    
    .sidenav .nav-link:not(.active):hover {
      background: rgba(0, 184, 148, 0.08) !important;
      color: #00B894 !important;
      transform: translateX(6px);
    }
    
    .sidenav .nav-link:not(.active):hover i {
      opacity: 1;
      color: #00B894;
      transform: scale(1.15);
    }
    
    .sidenav .nav-link.active {
      background: var(--success-gradient) !important;
      color: #ffffff !important;
      box-shadow: 0 8px 24px rgba(0, 184, 148, 0.4);
    }
    
    .sidenav .nav-link.active i {
      opacity: 1;
      color: #ffffff !important;
      transform: scale(1.1);
    }
    
    .sidenav .nav-link.active .nav-link-text {
      font-weight: 600;
      color: #ffffff !important;
    }
    
    .sidenav .nav-item.mt-3 h6 {
      padding: 10px 18px;
      margin: 20px 12px 10px 12px;
      font-size: 11px;
      letter-spacing: 1px;
      color: #636E72;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    #sidenav-collapse-main { display: block !important; visibility: visible !important; opacity: 1 !important; }
    #sidenav-collapse-main.show { display: block !important; }
    .sidenav .navbar-nav { display: block !important; }
    .sidenav-footer { position: absolute; bottom: 0; width: 100%; padding-bottom: 20px; }
    .sidenav .nav-item { display: block !important; visibility: visible !important; opacity: 1 !important; }
    .sidenav .nav-link.text-dark { color: #2D3436 !important; }

    /* Card Animations */
    .card {
      border: none;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .card:hover { transform: translateY(-5px); box-shadow: var(--hover-shadow); }

    /* Page Header */
    .page-header {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border-radius: 20px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }

    /* Avatar */
    .avatar-xl-custom {
      width: 120px;
      height: 120px;
      border-radius: 20px;
      object-fit: cover;
      border: 4px solid white;
      box-shadow: 0 8px 24px rgba(0,0,0,0.15);
      transition: all 0.4s ease;
    }
    .avatar-xl-custom:hover { transform: scale(1.05); }

    /* Form Styles */
    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #E9ECEF;
      padding: 12px 16px;
      transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
      border-color: #00B894;
      box-shadow: 0 0 0 4px rgba(0, 184, 148, 0.1);
    }
    .form-label { font-weight: 500; color: #2D3436; margin-bottom: 8px; }

    /* Badge Styles */
    .badge-modern {
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 11px;
    }

    /* Button Animations */
    .btn-animated {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .btn-animated:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }

    /* Navbar */
    .navbar-main {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 12px 20px;
      margin: 0 12px;
    }
    .breadcrumb-item a { color: #636E72; text-decoration: none; transition: color 0.3s; }
    .breadcrumb-item a:hover { color: #00B894; }
    .breadcrumb-item.active { color: #2D3436; font-weight: 600; }

    /* Image Preview */
    .image-preview-item {
      position: relative;
      overflow: hidden;
      border-radius: 12px;
    }
    .image-preview-item img {
      transition: transform 0.3s ease;
    }
    .image-preview-item:hover img { transform: scale(1.05); }

    /* Info List */
    .info-list { list-style: none; padding: 0; margin: 0; }
    .info-list li {
      padding: 16px 0;
      border-bottom: 1px solid #E9ECEF;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .info-list li:last-child { border-bottom: none; }
    .info-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
  </style>
</head>

<body class="g-sidenav-show bg-gray-100">
