<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="apple-touch-icon" sizes="76x76" href="/assets/img/apple-icon.png">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <title>Quản lý mùa vụ - BICAP Farm</title>
  <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700,900" />
  <link href="/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/assets/css/nucleo-svg.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
  <link id="pagestyle" href="/assets/css/material-dashboard.css?v=3.2.0" rel="stylesheet" />
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 50%, #00875A 100%);
      --secondary-gradient: linear-gradient(135deg, #6C5CE7 0%, #5B4BD5 100%);
      --success-gradient: linear-gradient(135deg, #00B894 0%, #00A86B 100%);
      --warning-gradient: linear-gradient(135deg, #FDCB6E 0%, #F39C12 100%);
      --danger-gradient: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
      --info-gradient: linear-gradient(135deg, #74B9FF 0%, #0984E3 100%);
      --card-shadow: 0 10px 40px rgba(0,0,0,0.08);
      --hover-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    body { font-family: 'Inter', sans-serif; }

    /* Navigation Styles */
    .sidenav { min-height: 100vh; }
    .sidenav .navbar-nav { list-style: none; padding: 0; margin: 0; }
    .sidenav .nav-item { margin-bottom: 4px; }
    
    .sidenav .nav-link {
      display: flex !important;
      align-items: center;
      padding: 14px 18px;
      margin: 6px 12px;
      border-radius: 16px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      color: #2D3436 !important;
      font-weight: 500;
      position: relative;
      text-decoration: none;
      width: auto;
      min-height: 48px;
      overflow: hidden;
    }
    
    .sidenav .nav-link::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      width: 4px;
      height: 100%;
      background: var(--success-gradient);
      border-radius: 0 8px 8px 0;
      transform: scaleY(0);
      transition: transform 0.3s ease;
    }
    
    .sidenav .nav-link:hover::before { transform: scaleY(1); }
    
    .sidenav .nav-link i {
      font-size: 22px !important;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 14px;
      opacity: 0.7;
      transition: all 0.4s ease;
      flex-shrink: 0;
    }
    
    .sidenav .nav-link .nav-link-text {
      font-size: 14px;
      transition: all 0.3s ease;
      white-space: nowrap;
    }
    
    .sidenav .nav-link:not(.active):hover {
      background: rgba(0, 184, 148, 0.08) !important;
      color: #00B894 !important;
      transform: translateX(6px);
    }
    
    .sidenav .nav-link:not(.active):hover i {
      opacity: 1;
      color: #00B894;
      transform: scale(1.15);
    }
    
    .sidenav .nav-link.active {
      background: var(--success-gradient) !important;
      color: #ffffff !important;
      box-shadow: 0 8px 24px rgba(0, 184, 148, 0.4);
    }
    
    .sidenav .nav-link.active i {
      opacity: 1;
      color: #ffffff !important;
      transform: scale(1.1);
    }
    
    .sidenav .nav-link.active .nav-link-text {
      font-weight: 600;
      color: #ffffff !important;
    }
    
    .sidenav .nav-item.mt-3 h6 {
      padding: 10px 18px;
      margin: 20px 12px 10px 12px;
      font-size: 11px;
      letter-spacing: 1px;
      color: #636E72;
      font-weight: 700;
      text-transform: uppercase;
    }
    
    #sidenav-collapse-main { display: block !important; visibility: visible !important; opacity: 1 !important; }
    #sidenav-collapse-main.show { display: block !important; }
    .sidenav .navbar-nav { display: block !important; }
    .sidenav-footer { position: absolute; bottom: 0; width: 100%; padding-bottom: 20px; }
    .sidenav .nav-item { display: block !important; visibility: visible !important; opacity: 1 !important; }
    .sidenav .nav-link.text-dark { color: #2D3436 !important; }

    /* Card Animations */
    .card {
      border: none;
      border-radius: 20px;
      box-shadow: var(--card-shadow);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .card:hover { transform: translateY(-5px); box-shadow: var(--hover-shadow); }

    /* Page Header */
    .page-header {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border-radius: 20px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    .page-header h3 { font-weight: 700; color: #2D3436; margin-bottom: 8px; }
    .page-header p { color: #636E72; margin: 0; }

    /* Table Styles */
    .table-modern { border-collapse: separate; border-spacing: 0; }
    .table-modern thead th {
      background: linear-gradient(135deg, #F8F9FA 0%, #E9ECEF 100%);
      border: none !important;
      font-weight: 600;
      color: #2D3436;
      padding: 16px 20px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .table-modern tbody td {
      border: none;
      border-bottom: 1px solid #F1F3F4;
      padding: 18px 20px;
      vertical-align: middle;
      transition: background 0.3s ease;
    }
    .table-modern tbody tr:hover td { background: rgba(0, 184, 148, 0.04); }

    /* Badge Styles */
    .badge-modern {
      padding: 6px 14px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 11px;
    }

    /* Button Animations */
    .btn-animated {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-animated:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.2); }

    /* Navbar */
    .navbar-main {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 12px 20px;
      margin: 0 12px;
    }
    .breadcrumb-item a { color: #636E72; text-decoration: none; transition: color 0.3s; }
    .breadcrumb-item a:hover { color: #00B894; }
    .breadcrumb-item.active { color: #2D3436; font-weight: 600; }

    /* Modal Styling */
    .modal-content { border: none; border-radius: 20px; overflow: hidden; }
    .modal-header { background: var(--success-gradient); color: white; border: none; padding: 20px 24px; }
    .modal-header h5 { font-weight: 600; }
    .modal-body { padding: 24px; }
    .modal-footer { border: none; padding: 16px 24px 24px; }

    .form-control, .form-select {
      border-radius: 12px;
      border: 2px solid #E9ECEF;
      padding: 12px 16px;
      transition: all 0.3s ease;
    }
    .form-control:focus, .form-select:focus {
      border-color: #00B894;
      box-shadow: 0 0 0 4px rgba(0, 184, 148, 0.1);
    }
    .form-label { font-weight: 500; color: #2D3436; margin-bottom: 8px; }

    /* Section Header */
    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .section-header-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
  <script>
    window.CONFIG = {
      API_GATEWAY_BASE_URL: "<%= API_GATEWAY_BASE_URL %>",
      PRODUCTION_BATCH_API_URL: "<%= PRODUCTION_BATCH_API_URL %>",
      FARMING_PROCESS_API_URL: "<%= FARMING_PROCESS_API_URL %>",
      EXPORT_BATCH_API_URL: "<%= EXPORT_BATCH_API_URL %>"
    };
  </script>
</head>

<body class="g-sidenav-show bg-gray-100">
  <!-- Sidebar -->
  <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-radius-lg fixed-start ms-2 bg-white my-2" id="sidenav-main">
    <div class="sidenav-header">
      <i class="fas fa-times p-3 cursor-pointer text-dark opacity-5 position-absolute end-0 top-0 d-none d-xl-none" aria-hidden="true" id="iconSidenav"></i>
      <a class="navbar-brand px-4 py-3 m-0" href="/dashboard">
        <div class="d-flex align-items-center">
          <div style="width:40px;height:40px;border-radius:12px;background:var(--success-gradient);display:flex;align-items:center;justify-content:center;margin-right:10px;">
            <i class="material-symbols-rounded text-white" style="font-size:22px;">agriculture</i>
          </div>
          <span class="ms-1 text-sm text-dark font-weight-bolder" style="font-size:16px !important;">BICAP Farm</span>
        </div>
      </a>
    </div>
    <hr class="horizontal dark mt-0 mb-2">
    <div class="collapse navbar-collapse w-auto show" id="sidenav-collapse-main" style="display: block !important; visibility: visible !important; opacity: 1 !important;">
      <ul class="navbar-nav" style="display: block !important; visibility: visible !important;">
        <li class="nav-item">
          <a class="nav-link" href="/dashboard">
            <i class="material-symbols-rounded">dashboard</i>
            <span class="nav-link-text">Trang chủ</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/products">
            <i class="material-symbols-rounded">storefront</i>
            <span class="nav-link-text">Quản lý sản phẩm</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/shipping">
            <i class="material-symbols-rounded">local_shipping</i>
            <span class="nav-link-text">Vận chuyển</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link active" href="/season-monitor">
            <i class="material-symbols-rounded">grass</i>
            <span class="nav-link-text">Quản lý mùa vụ</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/farm-info">
            <i class="material-symbols-rounded">agriculture</i>
            <span class="nav-link-text">Thông tin trang trại</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/notifications">
            <i class="material-symbols-rounded">notifications</i>
            <span class="nav-link-text">Thông báo</span>
          </a>
        </li>
        <li class="nav-item mt-3">
          <h6>Tài khoản</h6>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/profile">
            <i class="material-symbols-rounded">person</i>
            <span class="nav-link-text">Hồ sơ cá nhân</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="javascript:void(0);" id="logout-button">
            <i class="material-symbols-rounded">logout</i>
            <span class="nav-link-text">Đăng xuất</span>
          </a>
        </li>
      </ul>
    </div>
    <div class="sidenav-footer position-absolute w-100 bottom-0">
      <div class="mx-3 mb-3">
        <div class="card" style="border-radius:20px;background:var(--success-gradient);">
          <div class="card-body p-3 text-center text-white">
            <div style="width:56px;height:56px;border-radius:16px;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
              <i class="material-symbols-rounded" style="font-size:28px;">eco</i>
            </div>
            <p class="text-sm mb-1 font-weight-bold">BICAP Farm</p>
            <p class="text-xs mb-0 opacity-80">Hệ thống quản lý</p>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <!-- Navbar -->
    <nav class="navbar navbar-main navbar-expand-lg px-0 mx-3 shadow-none" id="navbarBlur" data-scroll="true">
      <div class="container-fluid py-1 px-3">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb bg-transparent mb-0 pb-0 pt-1 px-0 me-sm-6 me-5">
            <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="javascript:;">Trang</a></li>
            <li class="breadcrumb-item text-sm text-dark active font-weight-bold" aria-current="page">Quản lý mùa vụ</li>
          </ol>
        </nav>
        <div class="collapse navbar-collapse mt-sm-0 mt-2 me-md-0 me-sm-4" id="navbar">
          <ul class="navbar-nav d-flex align-items-center justify-content-end">
            <li class="nav-item d-flex align-items-center">
              <a href="/profile" class="nav-link text-body font-weight-bold px-0">
                <i class="material-symbols-rounded">account_circle</i>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container-fluid py-4">
      <!-- Page Header -->
      <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h3 class="mb-1"><i class="material-symbols-rounded text-success me-2" style="font-size:28px;">grass</i> Quản lý mùa vụ</h3>
            <p>Theo dõi và quản lý các mùa vụ của trang trại một cách hiệu quả.</p>
          </div>
          <button class="btn btn-success btn-animated" data-bs-toggle="modal" data-bs-target="#createSeasonModal">
            <i class="material-symbols-rounded me-2">add</i> Tạo mùa vụ mới
          </button>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger" role="alert" style="border-radius: 16px;">
          <i class="material-symbols-rounded me-2">error</i>
          <%= error %>
        </div>
      <% } %>

      <!-- Seasons List -->
      <div class="row">
        <div class="col-12">
          <div class="card">
            <div class="card-header p-4" style="background: var(--primary-gradient);">
              <div class="section-header">
                <div class="section-header-icon bg-white bg-opacity-25">
                  <i class="material-symbols-rounded text-white">list</i>
                </div>
                <div>
                  <h5 class="text-white mb-0">Danh sách mùa vụ</h5>
                  <p class="text-white text-sm mb-0 opacity-80">Quản lý thông tin và tiến trình các mùa vụ</p>
                </div>
              </div>
            </div>
            <div class="card-body p-0">
              <div id="seasonsList">
                <% if (seasons && seasons.length > 0) { %>
                  <div class="table-responsive">
                    <table class="table table-modern mb-0">
                      <thead>
                        <tr>
                          <th class="text-uppercase">Mã mùa vụ</th>
                          <th class="text-uppercase">Loại sản phẩm</th>
                          <th class="text-uppercase">Ngày bắt đầu</th>
                          <th class="text-uppercase">Ngày kết thúc</th>
                          <th class="text-uppercase">Trạng thái</th>
                          <th class="text-uppercase">Thao tác</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% seasons.forEach(function(season) { %>
                          <tr>
                            <td>
                              <span class="badge badge-modern bg-gradient-secondary"><%= season.batchCode || 'N/A' %></span>
                            </td>
                            <td>
                              <div class="d-flex align-items-center">
                                <div style="width:36px;height:36px;border-radius:10px;background:rgba(0,184,148,0.1);display:flex;align-items:center;justify-content:center;margin-right:10px;">
                                  <i class="material-symbols-rounded text-success" style="font-size:18px;">eco</i>
                                </div>
                                <span class="text-sm font-weight-semibold"><%= season.productType || 'N/A' %></span>
                              </div>
                            </td>
                            <td>
                              <span class="text-sm"><%= season.startDate || 'N/A' %></span>
                            </td>
                            <td>
                              <span class="text-sm"><%= season.endDate || 'Chưa có' %></span>
                            </td>
                            <td>
                              <span class="badge badge-modern <%= season.status === 'SYNCED' ? 'bg-gradient-success' : season.status === 'PENDING_BLOCKCHAIN' ? 'bg-gradient-warning' : 'bg-gradient-secondary' %>">
                                <%= season.status === 'SYNCED' ? 'Đã đồng bộ' : season.status === 'PENDING_BLOCKCHAIN' ? 'Chờ xác nhận' : season.status || 'N/A' %>
                              </span>
                            </td>
                            <td>
                              <button class="btn btn-sm btn-outline-info me-1 btn-animated" onclick="viewSeasonDetail(<%= season.id %>)" title="Xem chi tiết">
                                <i class="material-symbols-rounded" style="font-size:16px;">visibility</i>
                              </button>
                              <button class="btn btn-sm btn-outline-warning me-1 btn-animated" onclick="updateProgress(<%= season.id %>)" title="Cập nhật tiến trình">
                                <i class="material-symbols-rounded" style="font-size:16px;">edit</i>
                              </button>
                              <button class="btn btn-sm btn-outline-success btn-animated" onclick="exportSeason(<%= season.id %>)" title="Xuất hàng">
                                <i class="material-symbols-rounded" style="font-size:16px;">download</i>
                              </button>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                <% } else { %>
                  <div class="text-center py-5">
                    <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg, rgba(0,184,148,0.1) 0%, rgba(0,184,148,0.05) 100%);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                      <i class="material-symbols-rounded text-success" style="font-size:36px;">grass</i>
                    </div>
                    <h5 class="mb-3">Chưa có mùa vụ nào</h5>
                    <p class="text-muted mb-4">Hãy tạo mùa vụ mới để bắt đầu quản lý trang trại của bạn.</p>
                    <button class="btn btn-success btn-animated" data-bs-toggle="modal" data-bs-target="#createSeasonModal">
                      <i class="material-symbols-rounded me-2">add</i> Tạo mùa vụ mới
                    </button>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Create Season Modal -->
  <div class="modal fade" id="createSeasonModal" tabindex="-1" aria-labelledby="createSeasonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5><i class="material-symbols-rounded me-2">add_circle</i> Tạo mùa vụ mới</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="createSeasonForm">
            <div class="mb-4">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">tag</i> Mã mùa vụ <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="batchCode" required placeholder="VD: MV-2024-001">
            </div>
            <div class="mb-4">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">eco</i> Loại sản phẩm <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="productType" required placeholder="VD: Cà chua, Lúa, Ngô...">
            </div>
            <div class="row">
              <div class="col-6 mb-4">
                <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">calendar_today</i> Ngày bắt đầu <span class="text-danger">*</span></label>
                <input type="date" class="form-control" name="startDate" required>
              </div>
              <div class="col-6 mb-4">
                <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">event</i> Ngày kết thúc dự kiến</label>
                <input type="date" class="form-control" name="endDate">
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="button" class="btn btn-success btn-animated" onclick="createSeason()">
            <i class="material-symbols-rounded me-1">save</i> Tạo mùa vụ
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Season Detail Modal -->
  <div class="modal fade" id="seasonDetailModal" tabindex="-1" aria-labelledby="seasonDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5><i class="material-symbols-rounded me-2">info</i> Chi tiết mùa vụ</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="seasonDetailContent">
          <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-3 text-muted">Đang tải...</p>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Update Progress Modal -->
  <div class="modal fade" id="updateProgressModal" tabindex="-1" aria-labelledby="updateProgressModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header" style="background: var(--warning-gradient);">
          <h5><i class="material-symbols-rounded me-2">update</i> Cập nhật tiến trình</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="updateProgressForm">
            <input type="hidden" id="progressBatchId" name="batchId">
            <div class="mb-4">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">category</i> Loại hoạt động <span class="text-danger">*</span></label>
              <select class="form-select" name="processType" required>
                <option value="SOWING">Gieo trồng</option>
                <option value="WATERING">Tưới nước</option>
                <option value="FERTILIZING">Bón phân</option>
                <option value="PEST_CONTROL">Phòng trừ sâu bệnh</option>
                <option value="HARVESTING">Thu hoạch</option>
                <option value="OTHER">Khác</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">description</i> Mô tả <span class="text-danger">*</span></label>
              <textarea class="form-control" name="description" rows="3" required placeholder="Mô tả chi tiết hoạt động..."></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">schedule</i> Ngày thực hiện <span class="text-danger">*</span></label>
              <input type="datetime-local" class="form-control" name="performedDate" required>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="button" class="btn btn-warning btn-animated" onclick="submitProgress()">
            <i class="material-symbols-rounded me-1">update</i> Cập nhật
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Export Season Modal -->
  <div class="modal fade" id="exportSeasonModal" tabindex="-1" aria-labelledby="exportSeasonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header" style="background: var(--info-gradient);">
          <h5><i class="material-symbols-rounded me-2">upload</i> Xuất tiến trình mùa vụ</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="exportSeasonForm">
            <input type="hidden" id="exportBatchId" name="batchId">
            <div class="mb-4">
              <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">tag</i> Mã xuất hàng <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="batchCode" required placeholder="VD: XH-001">
            </div>
            <div class="row">
              <div class="col-6 mb-4">
                <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">inventory</i> Số lượng <span class="text-danger">*</span></label>
                <input type="number" step="0.01" class="form-control" name="quantity" required placeholder="VD: 100">
              </div>
              <div class="col-6 mb-4">
                <label class="form-label"><i class="material-symbols-rounded text-success me-1" style="font-size:18px;">straighten</i> Đơn vị <span class="text-danger">*</span></label>
                <select class="form-select" name="unit" required>
                  <option value="kg">Kilogram (kg)</option>
                  <option value="ton">Tấn</option>
                  <option value="box">Hộp</option>
                  <option value="bag">Bao</option>
                </select>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="button" class="btn btn-info btn-animated" onclick="submitExport()">
            <i class="material-symbols-rounded me-1">send</i> Xuất hàng
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- QR Code Modal -->
  <div class="modal fade" id="qrCodeModal" tabindex="-1" aria-labelledby="qrCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5><i class="material-symbols-rounded me-2">qr_code</i> QR Code xuất hàng</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center">
          <div id="qrCodeImage"></div>
          <p class="mt-3 text-muted">Quét mã QR để truy xuất nguồn gốc sản phẩm</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/assets/js/core/popper.min.js"></script>
  <script src="/assets/js/core/bootstrap.min.js"></script>
  <script src="/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/assets/js/material-dashboard.min.js?v=3.2.0"></script>

  <script>
    function getAuthToken() {
      const cookies = document.cookie.split(';');
      for (let cookie of cookies) {
        const [name, value] = cookie.trim().split('=');
        if (name === 'farm_token' || name === 'auth_token') {
          return value;
        }
      }
      return null;
    }

    async function createSeason() {
      const form = document.getElementById('createSeasonForm');
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/season-monitor/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data)
        });

        if (response.ok) {
          alert('Tạo mùa vụ thành công!');
          location.reload();
        } else {
          const error = await response.json();
          alert('Đã xảy ra lỗi: ' + (error.error || 'Không thể tạo mùa vụ'));
        }
      } catch (error) {
        alert('Đã xảy ra lỗi: ' + error.message);
      }
    }

    async function viewSeasonDetail(seasonId) {
      const modal = new bootstrap.Modal(document.getElementById('seasonDetailModal'));
      const content = document.getElementById('seasonDetailContent');
      content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-success" role="status"></div><p class="mt-3 text-muted">Đang tải...</p></div>';

      try {
        const response = await fetch(`/api/season-monitor/${seasonId}/detail`, {
          method: 'GET',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include'
        });

        if (response.ok) {
          const data = await response.json();
          let html = `
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted text-xs font-weight-bold mb-3">Thông tin mùa vụ</h6>
                <div class="mb-3">
                  <p class="text-xs text-muted mb-1">Mã mùa vụ</p>
                  <p class="text-sm font-weight-semibold">${data.productionBatch?.batchCode || 'N/A'}</p>
                </div>
                <div class="mb-3">
                  <p class="text-xs text-muted mb-1">Loại sản phẩm</p>
                  <p class="text-sm font-weight-semibold">${data.productionBatch?.productType || 'N/A'}</p>
                </div>
                <div class="mb-3">
                  <p class="text-xs text-muted mb-1">Ngày bắt đầu</p>
                  <p class="text-sm font-weight-semibold">${data.productionBatch?.startDate || 'N/A'}</p>
                </div>
                <div class="mb-3">
                  <p class="text-xs text-muted mb-1">Ngày kết thúc</p>
                  <p class="text-sm font-weight-semibold">${data.productionBatch?.endDate || 'Chưa có'}</p>
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-uppercase text-muted text-xs font-weight-bold mb-3">Tiến trình canh tác (${data.farmingProcesses?.length || 0})</h6>
                ${data.farmingProcesses && data.farmingProcesses.length > 0 ? 
                  data.farmingProcesses.map(p => `
                    <div class="d-flex align-items-start mb-2 p-2" style="background:#F8F9FA;border-radius:10px;">
                      <i class="material-symbols-rounded text-success me-2" style="font-size:20px;">check_circle</i>
                      <div>
                        <p class="text-sm font-weight-semibold mb-0">${p.processType || 'N/A'}</p>
                        <p class="text-xs text-muted mb-0">${p.performedDate || 'N/A'}</p>
                      </div>
                    </div>
                  `).join('') : '<p class="text-sm text-muted">Chưa có tiến trình nào</p>'}
              </div>
            </div>
          `;
          content.innerHTML = html;
        } else {
          content.innerHTML = '<div class="alert alert-danger"><strong>Đã xảy ra lỗi:</strong> Không thể tải chi tiết mùa vụ</div>';
        }
      } catch (error) {
        content.innerHTML = '<div class="alert alert-danger">Đã xảy ra lỗi: ' + error.message + '</div>';
      }

      modal.show();
    }

    function updateProgress(batchId) {
      document.getElementById('progressBatchId').value = batchId;
      const modal = new bootstrap.Modal(document.getElementById('updateProgressModal'));
      modal.show();
    }

    async function submitProgress() {
      const form = document.getElementById('updateProgressForm');
      const formData = new FormData(form);
      const batchId = formData.get('batchId');
      const data = {
        processType: formData.get('processType'),
        description: formData.get('description'),
        performedDate: formData.get('performedDate')
      };

      try {
        const response = await fetch(`/api/season-monitor/${batchId}/progress`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data)
        });

        if (response.ok) {
          alert('Cập nhật tiến trình thành công!');
          bootstrap.Modal.getInstance(document.getElementById('updateProgressModal')).hide();
          location.reload();
        } else {
          const error = await response.json();
          alert('Đã xảy ra lỗi: ' + (error.error || 'Không thể cập nhật tiến trình'));
        }
      } catch (error) {
        alert('Đã xảy ra lỗi: ' + error.message);
      }
    }

    function exportSeason(batchId) {
      document.getElementById('exportBatchId').value = batchId;
      const modal = new bootstrap.Modal(document.getElementById('exportSeasonModal'));
      modal.show();
    }

    async function submitExport() {
      const form = document.getElementById('exportSeasonForm');
      const formData = new FormData(form);
      const batchId = formData.get('batchId');
      const data = {
        batchCode: formData.get('batchCode'),
        quantity: parseFloat(formData.get('quantity')),
        unit: formData.get('unit')
      };

      try {
        const response = await fetch(`/api/season-monitor/${batchId}/export`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(data)
        });

        if (response.ok) {
          const result = await response.json();
          bootstrap.Modal.getInstance(document.getElementById('exportSeasonModal')).hide();
          
          if (result.qrCodeImage) {
            showQRCode(result.qrCodeImage);
          }
          alert('Xuất hàng thành công!');
          location.reload();
        } else {
          const error = await response.json();
          alert('Đã xảy ra lỗi: ' + (error.error || 'Không thể xuất hàng'));
        }
      } catch (error) {
        alert('Đã xảy ra lỗi: ' + error.message);
      }
    }

    function showQRCode(qrCodeImage) {
      const modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
      document.getElementById('qrCodeImage').innerHTML = `<img src="${qrCodeImage}" alt="QR Code" class="img-fluid" style="max-width: 300px;">`;
      modal.show();
    }

    (function() {
      function showNavigation() {
        const sidenavCollapse = document.getElementById('sidenav-collapse-main');
        if (sidenavCollapse) {
          sidenavCollapse.classList.add('show');
          sidenavCollapse.style.display = 'block';
          sidenavCollapse.style.visibility = 'visible';
          sidenavCollapse.style.opacity = '1';
        }
        const navItems = document.querySelectorAll('.sidenav .nav-item');
        navItems.forEach(item => { item.style.display = 'block'; item.style.visibility = 'visible'; item.style.opacity = '1'; });
        const navLinks = document.querySelectorAll('.sidenav .nav-link');
        navLinks.forEach(link => { link.style.display = 'flex'; link.style.visibility = 'visible'; link.style.opacity = '1'; });
      }
      
      showNavigation();
      
      document.addEventListener('DOMContentLoaded', function() {
        showNavigation();
        
        document.getElementById('logout-button')?.addEventListener('click', function() {
          fetch('/logout', { method: 'POST' })
            .then(() => window.location.href = '/login')
            .catch(err => console.error('Lỗi đăng xuất:', err));
        });
      });
      
      setTimeout(showNavigation, 100);
      setTimeout(showNavigation, 500);
    })();
  </script>
</body>
</html>
